# Base URL of the HandsOnRepo FastAPI backend. When set, /api/* is proxied there.
# Leave unset to run the UI against fixtures/*.json.
BACKEND_URL=http://localhost:8000

# Force fixture mode even when BACKEND_URL is set.
# USE_FIXTURES=true

# Public repository link shown in the header and the Connect MCP dialog.
NEXT_PUBLIC_REPO_URL=https://github.com/mithuna2357/FalkorDB
