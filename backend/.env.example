# Copy to backend/.env and fill in. Never commit .env.

# FalkorDB (local Docker needs only host/port; FalkorDB Cloud needs all four)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GRAPH_PREFIX=brain_

# GitHub: a classic token with public_repo scope (or fine-grained with Contents+Issues+PRs read).
# Required for GraphQL ingestion (reviews, PR files, issues at scale).
GITHUB_TOKEN=
# Sign in with GitHub (OAuth App: Settings -> Developer settings -> OAuth Apps -> New OAuth App)
#   Authorization callback URL must be exactly: <BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=public_repo
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:8000
# Secret you set on the demo repo webhook (Settings -> Webhooks)
GITHUB_WEBHOOK_SECRET=
# The only repo the agent may write comments to, e.g. mithuna/orbyte-demo-service
ACTION_REPO=

# LLM: any OpenAI-compatible endpoint with tool calling
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-5-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Ingestion limits
MAX_REPOS=8
MAX_COMMITS_PER_REPO=400
MAX_PRS_PER_REPO=300
MAX_ISSUES_PER_REPO=300
